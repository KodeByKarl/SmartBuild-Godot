# SmartBuild Godot local environment
# Copy to env.local and fill real values.
# env.local is gitignored — never commit secrets.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Set false in production / formal builds
SUPABASE_ENABLED=true
SUPABASE_PREVIEW_FALLBACK=false

# Editor / desktop only (ignored when SmartBuildBridge is present)
# DEBUG_MOCK_SESSION=true
# DEBUG_SHOW_MODULE_PICKER=true
# DEBUG_STANDALONE_MODULE_ID=1
# DEBUG_STANDALONE_SIMULATION_TYPE=0
